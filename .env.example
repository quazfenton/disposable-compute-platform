# Disposable Compute Platform Configuration

# API Configuration
ALLOWED_ORIGINS=*
DOMAIN=preview.yourapp.dev
DEFAULT_TTL=30
MAX_TTL=1440
STORAGE_PATH=/tmp/disposable-storage
MAX_CONCURRENT_SESSIONS=50
ENVIRONMENT=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disposable_compute
DB_USER=postgres
DB_PASSWORD=

# Redis (Caching & Events)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Security & Auth
AUTH_SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
OPENAI_API_KEY=

# Virtualization
FIRECRACKER_SOCKET_PATH=/tmp/firecracker.socket
LIBVIRT_URI=qemu:///system

# Networking & Streaming
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Alerting
PAGERDUTY_API_KEY=
OPSGENIE_API_KEY=

# Feature Flags
ENABLE_GPU=false
ENABLE_VM=false
ENABLE_STREAMING=true
